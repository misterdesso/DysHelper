{
  "name": "dyshelper",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension to make the web more accessible for dyslexic users",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "lint": "eslint 'src/**/*.js'",
    "lint:fix": "eslint 'src/**/*.js' --fix",
    "format": "prettier --write 'src/**/*.{js,css,html}' 'static/**/*.json'",
    "format:check": "prettier --check 'src/**/*.{js,css,html}' 'static/**/*.json'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0"
  }
}
